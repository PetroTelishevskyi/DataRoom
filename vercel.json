{
	"experimentalServices": {
		"frontend": {
			"root": "frontend",
			"framework": "vite"
		},

		"backend": {
			"root": "backend",
			"runtime": "node",
			"entrypoint": "src/main.ts"
		}
	},

	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": {
				"service": "backend"
			}
		},
		{
			"source": "/(.*)",
			"destination": {
				"service": "frontend",
				"path": "/index.html"
			}
		}
	]
}
